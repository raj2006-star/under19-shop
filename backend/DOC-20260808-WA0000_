}

/* ---------------- stock helpers ---------------- */
async function deductStock(items) {
  // Validate all items have enough stock before deducting any of them.
  for (const item of items) {
    const p = await productsCol.findOne({ _id: item.id });
    if (!p) throw new Error(`Product not found: ${item.name || item.id}`);
    if (p.qty < item.qty) throw new Error(`Not enough stock for ${p.name} (only ${p.qty} left)`);
  }
  for (const item of items) {
    await productsCol.updateOne({ _id: item.id }, { $inc: { qty: -item.qty } });
    const p = await productsCol.findOne({ _id: item.id });
    await productsCol.updateOne({ _id: item.id }, { $set: { stock: p.qty > 0 } });
  }
}
async function restoreStock(items) {
  for (const item of items) {
    await productsCol.updateOne({ _id: item.id }, { $inc: { qty: item.qty } });
    const p = await productsCol.findOne({ _id: item.id });
    if (p) await productsCol.updateOne({ _id: item.id }, { $set: { stock: p.qty > 0 } });
  }
}

