/* ---------------- startup ---------------- */
const PORT = process.env.PORT || 4000;

async function start() {
  if (!MONGODB_URI) {
    console.error('MONGODB_URI environment variable is not set. Set it in your .env file (local) or your host\'s Environment settings (Render, etc).');
    process.exit(1);
  }
  const client = new MongoClient(MONGODB_URI);
  await client.connect();
  const db = client.db(MONGODB_DB_NAME);
  productsCol = db.collection('products');
  couponsCol = db.collection('coupons');
  ordersCol = db.collection('orders');
  usersCol = db.collection('users');
  settingsCol = db.collection('settings');
  await ensureSeedData();
  app.listen(PORT, () => console.log('UNDER19 COLLXN backend running on port ' + PORT + ', connected to MongoDB.'));
}

start().catch(err => {
  console.error('Failed to start server:', err);
  process.exit(1);
});
