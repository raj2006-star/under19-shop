/* ---------------- admin auth ---------------- */
const adminSessions = new Set();
function requireAdmin(req, res, next) {
  const token = req.headers['x-admin-token'];
  if (!token || !adminSessions.has(token)) return res.status(401).json({ error: 'Unauthorized' });
  next();
}

app.post('/api/admin/login', async (req, res) => {
  const { password } = req.body;
  const settings = await settingsCol.findOne({ _id: 'main' });
  if (!password || !settings || !bcrypt.compareSync(password, settings.adminPasswordHash)) {
    return res.status(401).json({ error: 'Incorrect password' });
  }
  const token = crypto.randomBytes(24).toString('hex');
  adminSessions.add(token);
  res.json({ token });
});

app.post('/api/admin/change-password', requireAdmin, async (req, res) => {
  const { newPassword } = req.body;
  if (!newPassword || newPassword.length < 4) return res.status(400).json({ error: 'Password must be at least 4 characters' });
  await settingsCol.updateOne({ _id: 'main' }, { $set: { adminPasswordHash: bcrypt.hashSync(newPassword, 10) } }, { upsert: true });
  res.json({ ok: true });
});

/* ---------------- image upload (admin) ----------------
   Images are converted to base64 data URIs and stored directly on the
   product document in MongoDB, so nothing is written to local disk
   (local disk on most free hosts is wiped on every restart). */
const upload = multer({
  storage: multer.memoryStorage(),
  limits: { fileSize: 5 * 1024 * 1024 }
});
app.post('/api/admin/upload-image', requireAdmin, upload.single('photo'), (req, res) => {
  if (!req.file) return res.status(400).json({ error: 'No file uploaded' });
  const dataUri = `data:${req.file.mimetype};base64,${req.file.buffer.toString('base64')}`;
  res.json({ url: dataUri });
});

/* ---------------- products ---------------- */
app.get('/api/products', async (req, res) => {
  const products = await productsCol.find({}).toArray();
  res.json(products.map(cleanDoc));
});

app.post('/api/admin/products', requireAdmin, async (req, res) => {
  const { name, price, icon, sku, desc, img, images, qty } = req.body;
  if (!name || !price) return res.status(400).json({ error: 'Name and price are required' });
  const stockQty = qty === undefined || qty === null || qty === '' ? 10 : Math.max(0, Number(qty));
  const imgList = Array.isArray(images) ? images.filter(Boolean) : (img ? [img] : []);
  const product = {
    _id: 'p' + Date.now(),
    name, price: Number(price), icon: icon || '🖤',
    images: imgList, img: imgList[0] || null,
    sku: sku || ('U19-' + Math.floor(Math.random() * 900 + 100)),
    desc: desc || '', qty: stockQty, stock: stockQty > 0
  };
  await productsCol.insertOne(product);
  res.json(cleanDoc(product));
});

app.put('/api/admin/products/:id', requireAdmin, async (req, res) => {
  const updates = { ...req.body };
  delete updates.id; delete updates._id;
  if (updates.qty !== undefined) {
    updates.qty = Math.max(0, Number(updates.qty) || 0);
    updates.stock = updates.qty > 0;
  }
  if (updates.images !== undefined) {
    updates.images = Array.isArray(updates.images) ? updates.images.filter(Boolean) : [];
    updates.img = updates.images[0] || null;
  }
  const result = await productsCol.updateOne({ _id: req.params.id }, { $set: updates });
  if (result.matchedCount === 0) return res.status(404).json({ error: 'Product not found' });
  const updated = await productsCol.findOne({ _id: req.params.id });
  res.json(cleanDoc(updated));
});

app.delete('/api/admin/products/:id', requireAdmin, async (req, res) => {
  await productsCol.deleteOne({ _id: req.params.id });
  res.json({ ok: true });
});

/* ---------------- coupons ---------------- */
app.get('/api/coupons/:code', async (req, res) => {
  const c = await couponsCol.findOne({ _id: req.params.code.toUpperCase(), active: true });
  if (!c) return res.status(404).json({ error: 'Invalid or inactive coupon code' });
  res.json(cleanDoc(c));
});

app.get('/api/admin/coupons', requireAdmin, async (req, res) => {
  const coupons = await couponsCol.find({}).toArray();
  res.json(coupons.map(cleanDoc));
});

app.post('/api/admin/coupons', requireAdmin, async (req, res) => {
  const { code, discount } = req.body;
  if (!code || !discount) return res.status(400).json({ error: 'Code and discount are required' });
  const upperCode = code.toUpperCase();
  const existing = await couponsCol.findOne({ _id: upperCode });
  if (existing) return res.status(400).json({ error: 'Coupon already exists' });
  const coupon = { _id: upperCode, code: upperCode, discount: Number(discount), active: true };
  await couponsCol.insertOne(coupon);
  res.json(cleanDoc(coupon));
});

app.put('/api/admin/coupons/:code', requireAdmin, async (req, res) => {
  const upperCode = req.params.code.toUpperCase();
  const updates = { ...req.body };
  delete updates.code; delete updates._id; delete updates.id;
  const result = await couponsCol.updateOne({ _id: upperCode }, { $set: updates });
  if (result.matchedCount === 0) return res.status(404).json({ error: 'Coupon not found' });
  const updated = await couponsCol.findOne({ _id: upperCode });
  res.json(cleanDoc(updated));
});

app.delete('/api/admin/coupons/:code', requireAdmin, async (req, res) => {
  await couponsCol.deleteOne({ _id: req.params.code.toUpperCase() });
  res.json({ ok: true });
});

