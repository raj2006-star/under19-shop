/* ---------------- customer order lookup / self-cancel ---------------- */
app.get('/api/my-orders/:phone', async (req, res) => {
  const orders = await ordersCol.find({ 'buyer.phone': req.params.phone }).toArray();
  res.json(orders.map(cleanDoc));
});

app.put('/api/my-orders/:id/cancel', async (req, res) => {
  const { phone } = req.body;
  const o = await ordersCol.findOne({ _id: req.params.id });
  if (!o) return res.status(404).json({ error: 'Order not found' });
  if (!phone || !o.buyer || o.buyer.phone !== phone) {
    return res.status(403).json({ error: 'Not authorized to cancel this order' });
  }
  if (o.status === 'Cancelled') return res.status(400).json({ error: 'Order is already cancelled' });
  await restoreStock(o.items);
  await ordersCol.updateOne({ _id: o._id }, { $set: { status: 'Cancelled' } });
  const updated = await ordersCol.findOne({ _id: o._id });
  res.json(cleanDoc(updated));
});

app.put('/api/admin/orders/:id', requireAdmin, async (req, res) => {
  const o = await ordersCol.findOne({ _id: req.params.id });
  if (!o) return res.status(404).json({ error: 'Order not found' });
  if (req.body.status) {
    if (req.body.status === 'Cancelled' && o.status !== 'Cancelled') await restoreStock(o.items);
    await ordersCol.updateOne({ _id: o._id }, { $set: { status: req.body.status } });
  }
  const updated = await ordersCol.findOne({ _id: o._id });
  res.json(cleanDoc(updated));
});

/* ---------------- cash on delivery ---------------- */
app.post('/api/place-cod-order', async (req, res) => {
  const { orderDetails } = req.body;
  if (!orderDetails || !orderDetails.items || !orderDetails.buyer) {
    return res.status(400).json({ error: 'Missing order details' });
  }
  try {
    await deductStock(orderDetails.items);
  } catch (e) {
    return res.status(400).json({ error: e.message });
  }
  const order = {
    _id: 'U19' + Date.now().toString().slice(-8),
    razorpayOrderId: null,
    razorpayPaymentId: null,
    items: orderDetails.items,
    subtotal: orderDetails.subtotal,
    discount: orderDetails.discount,
    total: orderDetails.total,
    coupon: orderDetails.coupon || null,
    buyer: orderDetails.buyer,
    paymentMethod: 'Cash on Delivery',
    status: 'Pending (COD)',
    date: new Date().toISOString()
  };
  await ordersCol.insertOne(order);
  res.json({ ok: true, orderId: order._id });
});

